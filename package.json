{
  "name": "repository-custodian",
  "version": "0.1.0",
  "private": true,
  "description": "CAB432 Assessment 2 Track B: Repository Custodian (ACP chat client, ECS agent, MCP server and Lambda workers).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "build:lambdas": "node scripts/build.mjs lambdas",
    "build:agent": "node scripts/build.mjs agent",
    "build:all": "vite build && tsc --noEmit && node scripts/build.mjs all",
    "preview": "vite preview",
    "server": "tsx server/deterministic-acp.ts",
    "agent:dev": "vite build && tsx backend/agent-server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1139.0",
    "@aws-sdk/client-dynamodb": "^3.1139.0",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/client-s3vectors": "^3.1139.0",
    "@aws-sdk/client-secrets-manager": "^3.1139.0",
    "@aws-sdk/client-sqs": "^3.1139.0",
    "@aws-sdk/client-ssm": "^3.1139.0",
    "@aws-sdk/lib-dynamodb": "^3.1139.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "aws-jwt-verify": "^5.2.1",
    "dompurify": "3.4.14",
    "marked": "16.1.2",
    "ws": "8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "3.2.7"
  }
}
